{
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -fsS --max-time 10 -H \"Title: Claude Code ($(hostname -s): $(basename \"$PWD\"))\" -H \"Priority: default\" -H \"Tags: white_check_mark\" -d 'Task Completed' https://ntfy.sh/{{ .ntfyTopic }} >/dev/null 2>&1 || true; rm -f \"${XDG_CACHE_HOME:-$HOME/.cache}/claude-ntfy/last-input\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/ntfy-input.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ai-setup@pento-marketplace": true
  },
  "extraKnownMarketplaces": {
    "pento-marketplace": {
      "source": {
        "source": "github",
        "repo": "pentoai/pento-eng-plugins"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 260000,
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true
}
