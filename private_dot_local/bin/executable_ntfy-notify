#!/usr/bin/env bash
# Generic desktop handler for `ntfy subscribe --from-config`; usable by any topic.
# ntfy exports: $title $message $priority $tags $topic
# Icon is chosen from the tag, NOT the priority: a sender can keep ntfy
# priority high so phones raise a heads-up, while urgency here stays `normal`
# because swaync's timeout-critical is 0 (critical never auto-dismisses).
# No sound is played on purpose.
set -u
case "${tags:-}" in
  *question*)  icon=dialog-question ;;
  *warning*)   icon=dialog-warning ;;
  *)           icon=utilities-terminal ;;
esac
notify-send -u normal -i "$icon" "${title:-ntfy}" "${message:-}"
