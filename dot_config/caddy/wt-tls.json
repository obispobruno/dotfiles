{
  "apps": {
    "http": {
      "servers": {
        "wt": {
          "listen": [":443"],
          "automatic_https": {"disable": true},
          "tls_connection_policies": [{}],
          "routes": []
        },
        "wt-http": {
          "listen": [":80"],
          "automatic_https": {"disable": true},
          "routes": [{
            "handle": [{
              "handler": "static_response",
              "status_code": 308,
              "headers": {"Location": ["https://{http.request.host}{http.request.uri}"]}
            }]
          }]
        }
      }
    },
    "tls": {
      "certificates": {"automate": ["*.brunolcl.duckdns.org"]},
      "automation": {
        "policies": [{
          "subjects": ["*.brunolcl.duckdns.org"],
          "issuers": [{
            "module": "acme",
            "ca": "https://acme-staging-v02.api.letsencrypt.org/directory",
            "challenges": {"dns": {"provider": {"name": "duckdns", "api_token": "{env.DUCKDNS_TOKEN}"}}}
          }]
        }]
      }
    }
  }
}
