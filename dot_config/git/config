[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[user]
	email = obispobruno@tuta.com
	name = obispobruno
	signingkey = /home/openclaw/.ssh/id_ed25519_signing.pub
[init]
	defaultBranch = main
